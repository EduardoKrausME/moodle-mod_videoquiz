{{!
    @template mod_videoquiz/player
}}
<div class="videoquiz" id="videoquiz-player-{{cmid}}" data-region="videoquiz-root">
    <div class="videoquiz__stage" data-region="stage">
        {{#ishtml5}}
            <video class="videoquiz__video" data-region="html5-player" controls preload="metadata"
                   {{#poster}}poster="{{{poster}}}"{{/poster}}
                {{#disabledownload}}controlslist="nodownload"{{/disabledownload}}>
                <source src="{{{url}}}">
                {{#captions}}
                    <track kind="subtitles" src="{{{url}}}" srclang="{{language}}" label="{{label}}">
                {{/captions}}
                {{#str}}browservideonotsupported, videoquiz{{/str}}
            </video>
        {{/ishtml5}}
        {{#isembed}}
            <div class="videoquiz__embed" data-region="embed-player"></div>
        {{/isembed}}

        <div class="videoquiz__overlay d-none" data-region="question-overlay" aria-hidden="true">
            <div class="videoquiz__question" role="dialog" aria-modal="true"
                 aria-labelledby="videoquiz-question-title-{{cmid}}">
                <div class="videoquiz__time" data-region="question-time"></div>
                <h3 id="videoquiz-question-title-{{cmid}}" data-region="question-text"></h3>
                <div class="videoquiz__answers" data-region="answers"></div>
                <div class="videoquiz__feedback d-none" data-region="feedback" role="status"></div>
                <div class="videoquiz__actions">
                    <button type="button" class="btn btn-primary" data-action="submit-answer">{{#str}}
                        saveanswer, videoquiz{{/str}}</button>
                    <button type="button" class="btn btn-secondary d-none" data-action="continue-video">{{#str}}
                        continuevideo, videoquiz{{/str}}</button>
                </div>
            </div>
        </div>
    </div>
    <div class="videoquiz__summary mt-2" aria-live="polite">
        <span class="badge bg-secondary me-2">{{#str}}watchedpercent, videoquiz{{/str}}: <span
                data-region="watched-percent">{{watchedpercent}}</span>%</span>
        <span class="badge bg-secondary">{{#str}}grade, videoquiz{{/str}}: <span
                data-region="score">{{score}}</span>%</span>
    </div>
</div>
